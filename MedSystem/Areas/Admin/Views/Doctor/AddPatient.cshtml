@model Doctor

@{
    ViewBag.Title = "title";
    Layout = "_LayoutAdmin";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-primary text-white p-3 rounded-top-3">
                    <h4 class="mb-0 d-flex align-items-center">
                        <i class="bi bi-person-plus-fill me-2"></i> Доделете пациент на доктор
                    </h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted small mb-4">Пребарајте пациент по ЕМБГ за негово доделување на доктор.</p>

                    <form asp-action="AddPatientToDoctor"  method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold small"></div>
                        <input type="hidden" value="@ViewBag.DoctorId" name="doctorId"/>
                        <div class="mb-3">
                            <label>ЕМБГ на пациент</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-person-fill"></i></span>
                                <input class="form-control" placeholder="13 цифрен матичен број" id="embg-input"/>
                                <a class="btn btn-dark" id="search-button">Пребарај</a>
                            </div>
                        </div>
                        
                        
                        <div id="patientResult"></div>
                        
                        
                        
                        @* <div class="row g-3 mb-3"> *@
                        @*     <div class="col-md-6"> *@
                        @*         <label asp-for="SpecializationId" class="form-label small fw-bold text-secondary"></label> *@
                        @*         <div class="input-group"> *@
                        @*             <span class="input-group-text bg-light text-muted"><i class="bi bi-patch-check"></i></span> *@
                        @*             <select asp-for="SpecializationId" class="form-select" asp-items="ViewBag.Specializations"> *@
                        @*                 <option value="">Изберете специјализација</option> *@
                        @*             </select> *@
                        @*         </div> *@
                        @*         <span asp-validation-for="SpecializationId" class="text-danger small"></span> *@
                        @*     </div> *@
                        @*      *@
                        @*     <div class="col-md-6"> *@
                        @*         <label asp-for="CityId" class="form-label small fw-bold text-secondary">Град на ординација</label> *@
                        @*         <div class="input-group"> *@
                        @*             <span class="input-group-text bg-light text-muted"><i class="bi bi-geo-alt"></i></span> *@
                        @*             <select asp-for="CityId" class="form-select" asp-items="ViewBag.Cities"> *@
                        @*                 <option value="">-- Изберете град --</option> *@
                        @*             </select> *@
                        @*         </div> *@
                        @*         <span asp-validation-for="CityId" class="text-danger small"></span> *@
                        @*     </div> *@
                        @* </div> *@
                        @* *@
                       
                        
                        <div id="search-error" class="text-danger small mt-1 d-block"></div>
                       
                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                                    <div>
                                        @ViewBag.Error
                                    </div>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <hr class="text-muted my-4" />

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-arrow-left me-1"></i> Назад
                            </a>
                            <button type="submit" disabled="true" class="btn btn-primary px-4 fw-bold" id="submit-button">
                                <i class="bi bi-check-circle me-1"></i> Потврди доделување
                            </button>
                        </div>
                    </form>
                    
                    
                </div>
                
                
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        document.getElementById("search-button").addEventListener('click', () => {
            const embg = document.getElementById("embg-input").value
            const resultDiv = document.getElementById("patientResult")
            const submitButton = document.getElementById("submit-button")
            const errorDiv = document.getElementById("search-error")
            
            resultDiv.innerHTML = ""
            errorDiv.innerHTML = ""
            
            @* submitButton.disabled = true *@
            
            fetch(`/Admin/Doctor/GetPatientByEmbg?embg=${embg}`)
                .then(res => {
                    if(!res.ok) {
                        if (res.status === 404) {
                            throw new Error("Пациентот со даден ЕМБГ не е пронајден во системот.")
                        }
                        throw new Error("Серверска грешка, обидете се повторно.")
                    }
                    
                    return res.text()
                })
                .then(result => {
                    resultDiv.innerHTML = result
                    submitButton.disabled = false
                })
                .catch(error => {
                    errorDiv.innerText = error.message
                })
        })
    </script>
}
