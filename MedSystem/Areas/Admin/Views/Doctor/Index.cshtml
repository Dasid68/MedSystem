@model IEnumerable<Doctor>
@{
    ViewData["Title"] = "Менаџирање со доктори";
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-stethoscope me-2 text-primary"></i> Менаџирање со доктори</h2>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center">
        <i class="bi bi-person-plus-fill me-2"></i> Додади нов доктор
    </a>
</div>

<div class="card card-counter border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                <tr>
                    <th class="ps-4">Име и презиме</th>
                    <th>Е-маил</th>
                    <th>Специјализација</th>
                    <th class="text-end pe-4">Акции</th>
                </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">Нема пронајдено доктори во системот.</td>
                    </tr>
                }
                else
                {
                    @foreach (var doctor in Model)
                    {
                        <tr>
                            <td class="fw-bold ps-4">dr. @doctor.ApplicationUser.FirstName @doctor.ApplicationUser.LastName</td>
                            <td>@doctor.ApplicationUser.Email</td>
                            <td>@doctor.Specialization.Name</td>
                            <td class="text-end pe-4">
                                <a class="btn btn-outline-info btn-sm" asp-action="Details" asp-route-id="@doctor.Id">
                                    <i class="bi bi-eye-fill me-1"></i>Детали
                                </a>
                               
                                <button type="button" 
                                        class="btn btn-outline-danger btn-sm open-delete-modal"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-id="@doctor.Id"
                                        data-name="@doctor.ApplicationUser.FirstName @doctor.ApplicationUser.LastName">
                                        <i class="bi bi-trash"></i> Избриши
                                    </button>
                                
                                <a class="btn btn-outline-warning btn-sm" asp-action="Edit" asp-route-id="@doctor.Id">
                                    <i class="bi bi-pencil me-1"></i>Измени
                                </a>
                                <a class="btn btn-outline-secondary btn-sm" asp-action="AddPatient" asp-route-id="@doctor.Id">
                                    <i class="bi bi-person-add me-1"></i>Додади пациент
                                </a>

                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="Partials/_DeleteModal"/>


@section Scripts
{
    <script>
        const openModalButtons = document.querySelectorAll(".open-delete-modal")
        const deleteModal = document.getElementById("deleteModal");
       
        
        deleteModal.addEventListener("show.bs.modal", (e) => { 
            const button = e.relatedTarget

            const doctorId = button.getAttribute('data-id');
            const doctorName = button.getAttribute('data-name');
            
            console.log("Модалот се отвара за ID:", doctorId);
            console.log("Име на доктор:", doctorName);

            document.getElementById('doctorIdToDelete').value = doctorId;
            document.getElementById('doctorNameToDelete').textContent = doctorName;
        })
        
        
        
    </script>
}

