@using MedSystem.Areas.Admin.Models
@model IEnumerable<MedSystem.Areas.Admin.Models.SystemLog>

@{
    ViewBag.Title = "title";
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-stethoscope me-2 text-primary"></i>Системски логови</h2>
</div>

<div class="card card-counter border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                <tr>
                    <th class="ps-4">Порака</th>
                    <th>Акција</th>
                    <th>Тип</th>
                    <th class=" pe-4">Извршил</th>
                    <th>Датум и време</th>
                </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">Нема пронајдено логови во системот.</td>
                    </tr>
                }
                else
                {
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="fw-bold ps-4">@log.Message</td>
                            <td>
                                @{
                                    var action = log.Action switch
                                    {
                                        LogAction.Create => "Креирање",
                                        LogAction.Update => "Ажурирање",
                                        LogAction.Delete => "Бришење",
                                        LogAction.Login => "Логирање",
                                        LogAction.Logout => "Одлогирање",
                                            
                                    };
                                }
                                @action
                            </td>
                            <td>
                                @{
                                    var pillClass = log.LogType switch
                                    {
                                        LogType.Success => "bg-success text-white",
                                        LogType.Warning => "bg-warning text-dark",
                                        LogType.Danger  => "bg-danger text-white",
                                        LogType.Info    => "bg-info text-dark",
                                    };

                                    var type = log.LogType switch
                                    {
                                        LogType.Info => "Информација",
                                        LogType.Warning => "Предупредување",
                                        LogType.Danger => "Ризик",
                                        LogType.Success => "Успех"
                                    };
                                }
                                <span class="badge rounded-pill @pillClass px-3 py-2 fw-semibold">
                                    @type
                                </span>
                            </td>
                            <td>@log.PerformedBy</td>
                            <td>@log.Timestamp</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
