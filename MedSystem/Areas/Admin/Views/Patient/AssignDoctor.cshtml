@model Patient

@{
    ViewBag.Title = "Додели матичен лекар";
    Layout = "_LayoutAdmin";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-primary text-white p-3 rounded-top-3">
                    <h4 class="mb-0 d-flex align-items-center">
                        <i class="bi bi-person-plus-fill me-2"></i> Доделете матичен лекар на пациент
                    </h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted small mb-4" id="search-text">Пребарајте доктор по име и презиме.</p>

                    <form asp-action="AssignDoctor"  method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold small"></div>
                        <input type="hidden" value="@Model.Id" name="patientId"/>
                        <div class="mb-3" id="search-doctor-field">
                            <label>Име и презиме на доктор</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-person-fill"></i></span>
                                <input class="form-control" id="name-input"/>
                                <a class="btn btn-dark" id="search-button">Пребарај</a>
                            </div>
                        </div>
                        
                        
                        <div id="patientResult"></div>
                        
                        <div id="search-error" class="text-danger small mt-1 d-block"></div>
                       
                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                                    <div>
                                        @ViewBag.Error
                                    </div>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        
                        @* <div id="selected-doctor-container" style="visibility: hidden"> *@
                        @*     Selektiran doktor *@
                        @*      *@
                        @*     <input type="text" disabled value="" id="selected-doctor-id"/> *@
                        @*     <input type="text" disabled value="" id="selected-doctor-name"/> *@
                        @* </div> *@
                        
                     
                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Селектиран доктор за доделување:</label>
    
                         
                            <input type="hidden" id="selected-doctor-id" name="doctorId" value="" />
    
                         
                            <div id="selected-doctor-card" class="card border-2 p-3 text-center text-muted transition-all" 
                                 style="border-style: dashed !important; background-color: #fafafa; min-height: 80px;">
        
                              
                                <div id="selected-doctor-placeholder" class="py-2">
                                    <i class="bi bi-person-x fs-3 d-block mb-1 text-muted"></i>
                                    <span class="small fw-semibold">Сè уште немате избрано доктор. Пребарајте и изберете од листата.</span>
                                </div>

                               
                                <div id="selected-doctor-info" class="d-none text-start d-flex align-items-center justify-content-between py-1">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-3" 
                                             style="width: 45px; height: 45px;">
                                            <i class="bi bi-person-check-fill fs-5"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold text-dark" id="selected-doctor-name-text"></h6>
                                            <small class="text-success fw-semibold"><i class="bi bi-check2-circle me-1"></i>Избран за матичен лекар</small>
                                        </div>
                                    </div>
            
                                  
                                    <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-circle" id="remove-doctor-btn">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <hr class="text-muted my-4" />

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-arrow-left me-1"></i> Назад
                            </a>
                            <button type="submit" disabled="true" class="btn btn-primary px-4 fw-bold" id="submit-button">
                                <i class="bi bi-check-circle me-1"></i> Потврди доделување
                            </button>
                        </div>
                    </form>
                    
                    
                </div>
                
                
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        document.getElementById("search-button").addEventListener('click', () => {
            const name = document.getElementById("name-input").value
            const resultDiv = document.getElementById("patientResult")
            const submitButton = document.getElementById("submit-button")
            const errorDiv = document.getElementById("search-error")
            
            resultDiv.innerHTML = ""
            errorDiv.innerHTML = ""
            
            @* submitButton.disabled = true *@
            
            fetch(`/Admin/Patient/GetDoctorByName?searchQuery=${name}`)
                .then(res => {
                    if(!res.ok) {
                        if (res.status === 404) {
                            throw new Error("Дадениот доктор не е пронајден во системот.")
                        }
                        throw new Error("Серверска грешка, обидете се повторно.")
                    }
                    
                    return res.text()
                })
                .then(result => {
                    resultDiv.innerHTML = result
                    submitButton.disabled = false
                })
                .catch(error => {
                    errorDiv.innerText = error.message
                })
        })
        const selectedDiv = document.getElementById("selected-doctor-container")

        document.addEventListener("click", (e) => {
            const button = e.target.closest(".doctor-select-item");
            const resultDiv = document.getElementById("patientResult")
            
            if(button){
                e.preventDefault();

                var doctorId = button.getAttribute("data-id");
                var doctorName = button.getAttribute("data-fullname");
                @* var nameInput = document.getElementById("selected-doctor-name"); *@
                @* var idInput = document.getElementById("selected-doctor-id"); *@

                @* nameInput.value = doctorName; *@
                @* idInput.value = doctorId; *@

                const card = document.getElementById("selected-doctor-card");
                const placeholder = document.getElementById("selected-doctor-placeholder");
                const infoSection = document.getElementById("selected-doctor-info");
                const nameText = document.getElementById("selected-doctor-name-text");
                const idInput = document.getElementById("selected-doctor-id");
                const submitButton = document.getElementById("submit-button");
                const searchField = document.getElementById("search-doctor-field");
                const searchText = document.getElementById("search-text");
                
                
                idInput.value = doctorId;
                nameText.innerText = doctorName;

               
                placeholder.classList.add("d-none");
                infoSection.classList.remove("d-none");

                card.style.borderStyle = "solid !important";
                card.classList.remove("border-muted", "text-muted");
                card.classList.add("border-success", "bg-white", "shadow-sm");

              
                submitButton.disabled = false;
                searchField.style.display = "none";
                searchText.style.display = "none";

                resultDiv.innerHTML = ""
                selectedDiv.style.visibility = "visible";
            }
        })


        document.addEventListener("click", (e) => {
            const removeButtton = e.target.closest("#remove-doctor-btn");

            if (removeButtton) {
                e.preventDefault();
                
                console.log("BUtton pritisnat")

                const card = document.getElementById("selected-doctor-card");
                const placeholder = document.getElementById("selected-doctor-placeholder");
                const infoSection = document.getElementById("selected-doctor-info");
                const idInput = document.getElementById("selected-doctor-id");
                const submitButton = document.getElementById("submit-button");
                const searchField = document.getElementById("search-doctor-field");
                const searchText = document.getElementById("search-text");

               
                idInput.value = "";

            
                placeholder.classList.remove("d-none");
                infoSection.classList.add("d-none");

                card.style.borderStyle = "dashed !important";
                card.classList.remove("border-success", "bg-white", "shadow-sm");
                card.classList.add("text-muted");

                searchField.style.display = "block";
                searchText.style.display = "block";

                
                submitButton.disabled = true;
            }
        });
    </script>
}   
