@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLower();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - MedSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/MedSystem.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/sidebar/sidebar.css" asp-append-version="true">
</head>
<body >

<div class="container-fluid">
    <div class="row d-flex flex-column">
        
        <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse bg-dark">
            <div class="position-sticky pt-3 d-flex flex-column h-100 ">
                
                <div class="text-center mb-4 text-white px-3">
                    <i class="bi bi-heart-pulse-fill text-primary fs-1"></i>
                    <h5 class="mt-2 fw-bold">MedSystem</h5>
                    <h6 class="fw-semibold badge rounded-pill bg-danger px-3 py-2">Admin</h6>
                </div>
                <hr class="text-secondary" />
                
                <ul class="nav flex-column flex-nowrap flex-grow-1 pb-2">
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "home" ? "active text-white" : "text-white-50") " asp-area="Admin" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-speedometer2 me-2"></i> Контролна табла
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "doctor" ? "active text-white" : "text-white-50")" asp-area="Admin"  asp-controller="Doctor" asp-action="Index">
                            <i class="bi bi-person-vcard-fill me-2"></i> Доктори
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "patient" ? "active text-white" : "text-white-50")" asp-area="Admin" asp-controller="Patient" asp-action="Index">
                            <i class="bi bi-people-fill me-2"></i> Пациенти
                        </a>
                    </li>
                    <li class="nav-item ">
                        <a class="nav-link @(currentController == "specialization" ? "active text-white" : "text-white-50")" asp-area="Admin" asp-controller="Specialization" asp-action="Index">
                            <i class="bi bi-building me-2"></i> Оддели и специјализации
                        </a>
                    </li>
                    
                    <li class="nav-item ">
                        <a class="nav-link @(currentController == "log" ? "active text-white" : "text-white-50")" asp-area="Admin" asp-controller="Log" asp-action="Index">
                            <i class="bi bi-journal-text me-2"></i> Системски логови
                        </a>
                    </li>
                    
                    @if (!SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item mt-auto">
                            <a class="nav-link text-white-50" asp-area="Auth" asp-controller="Account" asp-action="RegisterPatient">Регистрација</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-area="Auth" asp-controller="Account" asp-action="Login">Најава</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item mt-auto border-top border-secondary pt-2">
                            <form asp-area="Auth" asp-controller="Account" asp-action="Logout" method="post" class="w-100">
                                <button type="submit" class="nav-link w-100 text-start border-0 bg-transparent d-flex align-items-center py-2 text-danger">
                                    <i class="bi bi-box-arrow-right me-2 fs-5"></i>
                                    <span>Одјави се</span>
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </nav>
        
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 p-5 flex-grow-1">

            <div class="flex-grow-1 pb-5">
                @RenderBody()
            </div>
            
            <footer class="border-top footer text-muted pt-3 pb-3 mt-auto">
                <p class="mb-0">&copy; @DateTime.Today.Year - MedSystem - <a asp-area="" asp-controller="Home" asp-action="Privacy">Приватност</a></p>
            </footer>
        </main>
        
    </div>
</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>