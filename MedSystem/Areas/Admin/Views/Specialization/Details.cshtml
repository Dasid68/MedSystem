@model IEnumerable<Doctor>

@{
    ViewBag.Title = "Детали за " + @ViewBag.Name;
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-stethoscope me-2 text-primary"></i> Детали за @ViewBag.Name</h2>
</div>

<div class="card card-counter border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                <tr>
                    <th class="ps-4">Име</th>
                    <th class="text-end pe-4">Акции</th>
                </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">Нема пронајдено доктори во @ViewBag.Name.</td>
                    </tr>
                }
                else
                {
                    @foreach (var doctor in Model)
                    {
                        <tr>
                            <td class="fw-bold ps-4">@doctor.ApplicationUser.FirstName @doctor.ApplicationUser.LastName</td>
                            <td class="text-end pe-4">
                                <a class="btn btn-outline-info btn-sm" asp-action="Details" asp-controller="Doctor" asp-route-id="@doctor.Id">Детали</a>
                                <button
                                    class="btn btn-outline-danger btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal"
                                    data-id="@doctor.Id"
                                    data-name="@doctor.ApplicationUser.FirstName @doctor.ApplicationUser.LastName"
                                    data-spec="@ViewBag.Id">
                                    Отстрани
                                </button>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="Partials/_DeleteDoctorSpecialization"/>



@section Scripts
{
    <script>
        const openModalButtons = document.querySelectorAll(".open-delete-modal")
        const deleteModal = document.getElementById("deleteModal");
       
        
        deleteModal.addEventListener("show.bs.modal", (e) => { 
            const button = e.relatedTarget

            const doctorId = button.getAttribute('data-id');
            const doctorName = button.getAttribute('data-name');
            const specId = button.getAttribute('data-spec');
           
            document.getElementById('doctorIdToDelete').value = doctorId;
            document.getElementById('doctorNameToDelete').textContent = doctorName;
            document.getElementById('specializationId').value = specId;
        })
        
        
        
    </script>
}
