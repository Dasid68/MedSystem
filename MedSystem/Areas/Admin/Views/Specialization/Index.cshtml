@model IEnumerable<Specialization>

@{
    ViewBag.Title = "Специјализации";
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-stethoscope me-2 text-primary"></i> Менаџирање со специјализации</h2>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center">
        <i class="bi bi-building-add me-2"></i> Додади нова специјализација
    </a>
</div>

<div class="card card-counter border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                <tr>
                    <th class="ps-4">Специјализација</th>
                    <th class="text-end pe-4">Акции</th>
                </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">Нема пронајдено специјализации во системот.</td>
                    </tr>
                }
                else
                {
                    @foreach (var specialization in Model)
                    {
                        <tr>
                            <td class="fw-bold ps-4">@specialization.Name</td>
                            <td class="text-end pe-4">
                                <a class="btn btn-outline-info btn-sm" asp-action="Details" asp-route-id="@specialization.Id">
                                    <i class="bi bi-eye-fill me-1"></i>Детали
                                </a>
                               
                                <button type="button" 
                                        class="btn btn-outline-danger btn-sm open-delete-modal"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-id="@specialization.Id"
                                        data-name="@specialization.Name">
                                    <i class="bi bi-trash"></i> Избриши
                                </button>
                                
                                <a class="btn btn-outline-warning btn-sm" asp-action="Edit" asp-route-id="@specialization.Id">
                                    <i class="bi bi-pencil me-1"></i>Измени
                                </a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>


<partial name="Partials/_DeleteModal"/>



@section Scripts
{
    <script>
        const openModalButtons = document.querySelectorAll(".open-delete-modal")
        const deleteModal = document.getElementById("deleteModal");
       
        
        deleteModal.addEventListener("show.bs.modal", (e) => { 
            const button = e.relatedTarget

            const specializationId = button.getAttribute('data-id');
            const specializationName = button.getAttribute('data-name');
           

            document.getElementById('specializationIdToDelete').value = specializationId;
            document.getElementById('specializationToDelete').textContent = specializationName;
        })
        
        
        
    </script>
}
