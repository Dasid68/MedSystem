@model MedSystem.Areas.Auth.Models.LoginViewModel
@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4 p-sm-5">
                    
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-gradient text-white rounded-circle mb-3" style="width: 60px; height: 60px;">
                            <i class="bi bi-box-arrow-in-right fs-3"></i>
                        </div>
                        <h2 class="fw-bold text-dark">Добредојдовте назад</h2>
                        <p class="text-muted small">Внесете ги вашите податоци за да се најавите во системот</p>
                    </div>

                    <form  method="post">
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none my-3" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control" id="floatingEmail" placeholder="name@example.com" />
                            <label asp-for="Email">Е-пошта (Email)</label>
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Password" class="form-control" id="floatingPassword" placeholder="Лозинка" />
                            <label asp-for="Password">Лозинка</label>
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="form-check mb-4 text-start">
                            <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                            <label asp-for="RememberMe" class="form-check-label text-muted small" for="rememberMeCheck">
                                Запомни ме на овој уред
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold shadow-sm text-white bg-gradient mb-3">
                            Најави се
                        </button>

                        <div class="text-center mt-3">
                            <span class="text-muted small">Немате профил? </span>
                            <a  class="text-decoration-none small fw-semibold">Креирај нов профил тука</a>
                        </div>

                    </form>
                    
                </div>
            </div>
            
        </div>
    </div>
</div>
