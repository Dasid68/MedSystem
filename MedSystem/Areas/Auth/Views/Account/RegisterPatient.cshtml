@using MedSystem.Enums
@model MedSystem.Areas.Auth.Models.RegisterPatientViewModel

@{
    ViewData["Title"] = "Регистрација на пациент";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-9">
            
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4 p-sm-5">
                    
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-gradient text-white rounded-circle mb-3" style="width: 60px; height: 60px;">
                            <i class="bi bi-person-plus fs-3"></i>
                        </div>
                        <h2 class="fw-bold text-dark">Креирај профил</h2>
                        <p class="text-muted small">Внесете ги вашите податоци за регистрација во системот</p>
                    </div>

                    <form asp-controller="Account" asp-area="Auth" asp-action="RegisterPatient"  method="post">
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none my-3" role="alert"></div>

                        <div class="row g-3">
                            
                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <input asp-for="FirstName" class="form-control" placeholder="Име" />
                                    <label asp-for="FirstName">Име</label>
                                    <span asp-validation-for="FirstName" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <input asp-for="LastName" class="form-control"  placeholder="Презиме" />
                                    <label asp-for="LastName">Презиме</label>
                                    <span asp-validation-for="LastName" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Email" class="form-control"  placeholder="name@example.com" />
                                    <label asp-for="Email">Е-пошта</label>
                                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Password" class="form-control" type="password"  placeholder="Лозинка" />
                                    <label asp-for="Password">Лозинка</label>
                                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <input asp-for="PhoneNumber" class="form-control" placeholder="07X-XXX-XXX" />
                                    <label asp-for="PhoneNumber">Телефонски број</label>
                                    <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Embg" class="form-control"  placeholder="ЕМБГ" />
                                    <label asp-for="Embg">ЕМБГ</label>
                                    <span asp-validation-for="Embg" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <input asp-for="DateOfBirth" class="form-control" type="date" id="floatingDOB" />
                                    <label asp-for="DateOfBirth">Датум на раѓање</label>
                                    <span asp-validation-for="DateOfBirth" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <select asp-for="Gender" class="form-select" asp-items="@Html.GetEnumSelectList<Gender>()">
                                        <option value="">-- Изберете пол --</option>
                                    </select>
                                    <label asp-for="Gender">Пол</label>
                                    <span asp-validation-for="Gender" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <select asp-for="CityId" class="form-select" asp-items="ViewBag.Cities">
                                        <option value="">--Изберете град--</option>
                                    </select>
                                    @* <input asp-for="CityId" class="form-control" placeholder="Град ID"/> *@
                                    <label asp-for="CityId">Град</label>
                                    <span asp-validation-for="CityId" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Address" class="form-control"  placeholder="Адреса" />
                                    <label asp-for="Address">Адреса</label>
                                    <span asp-validation-for="Address" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                        </div> <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold shadow-sm text-white bg-gradient mt-4 mb-3">
                            Регистрирај се
                        </button>

                        <div class="text-center">
                            <span class="text-muted small">Веќе имате профил? </span>
                            <a href="/auth/login" class="text-decoration-none small fw-semibold">Најави се тука</a>
                        </div>

                    </form>
                    
                </div>
            </div>
            
        </div>
    </div>
</div>

