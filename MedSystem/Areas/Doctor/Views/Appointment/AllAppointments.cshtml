@using MedSystem.Enums
@model List<MedSystem.Areas.Doctor.Models.AllAppointmentsViewModel>

@{
    ViewData["Title"] = "Сите прегледи";
    Layout = "_LayoutDoctor";
}

<div class="container-fluid py-4">
 
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-primary">
                <i class="bi bi-calendar3 me-2"></i>Сите прегледи
            </h3>
            <p class="text-muted small mb-0">Преглед на сите закажани, одобрени и завршени термини.</p>
        </div>
        <div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Назад
            </a>
        </div>
    </div>

    
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-3">Пациент</th>
                            <th scope="col">Датум и час</th>
                            <th scope="col">Причина за посета</th>
                            <th scope="col">Статус</th>
                            <th scope="col" class="pe-3">Дијагноза</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="fw-bold text-dark">@item.PatientName</div>
                                        <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@item.PatientPhone</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.AppointmentDate.ToString("dd.MM.yyyy")</div>
                                        <div class="text-muted small">@item.AppointmentDate.ToString("HH:mm") ч.</div>
                                    </td>
                                    <td>
                                        <span class="d-inline-block text-truncate" style="max-width: 220px;" title="@item.Reason">
                                            @item.Reason
                                        </span>
                                    </td>
                                    <td>
                                        @switch (item.Status)
                                        {
                                            case Status.Pending:
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                                    <i class="bi bi-hourglass-split me-1"></i>На чекање
                                                </span>
                                                break;
                                            case Status.Confirmed:
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                                    <i class="bi bi-check-circle me-1"></i>Одобрен
                                                </span>
                                                break;
                                            case Status.Completed:
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                    <i class="bi bi-check2-all me-1"></i>Завршен
                                                </span>
                                                break;
                                            case Status.Cancelled:
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                    <i class="bi bi-x-circle me-1"></i>Откажан
                                                </span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary-subtle text-secondary px-2 py-1">
                                                    @item.Status
                                                </span>
                                                break;
                                        }
                                    </td>
                                    <td class="pe-3">
                                        @if (!string.IsNullOrEmpty(item.Diagnosis))
                                        {
                                            <span class="small text-dark fw-semibold">@item.Diagnosis</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    Нема пронајдено регистрирани прегледи.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>