@model MedSystem.Areas.Doctor.Models.AppointmentViewModel

@{
    ViewData["Title"] = "Започни Преглед";
    Layout = "_LayoutDoctor";
}

<form asp-action="Complete" asp-controller="Appointment" method="post">
   
    <input type="hidden" asp-for="AppointmentId" />
    <input type="hidden" asp-for="PatientId" />

   
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" asp-controller="Home" class="btn btn-sm btn-outline-secondary mb-2">
                <i class="bi bi-arrow-left me-1"></i> Назад
            </a>
            <h3 class="fw-bold mb-0 text-primary">
                <i class="bi bi-stethoscope me-2"></i>Преглед во тек
            </h3>
        </div>
        <button type="submit" class="btn btn-success btn-lg shadow-sm">
            <i class="bi bi-check2-circle me-1"></i> Заврши Преглед
        </button>
    </div>

    <div class="row g-4">
       
        <div class="col-lg-8">

            <div class="card shadow-sm border-0 mb-4 bg-light">
                <div class="card-body">
                    <h6 class="fw-bold text-muted text-uppercase mb-2 small">Причина за посета</h6>
                    <p class="fs-6 fw-semibold text-dark mb-0">@Model.Reason</p>
                    <div class="mt-2 text-muted small">
                        <i class="bi bi-clock me-1"></i> Закажано за: <strong>@Model.AppointmentDate.ToString("dd.MM.yyyy HH:mm") часот</strong>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-chat-left-text text-primary me-2"></i>Симптоми и поплаки
                    </h5>
                </div>
                <div class="card-body pt-0">
                    <textarea asp-for="Symptoms" class="form-control shadow-none" rows="3" placeholder="Внесете ги симптомите кои ги опишува пациентот..."></textarea>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-file-earmark-medical text-primary me-2"></i>Дијагноза
                    </h5>
                </div>
                <div class="card-body pt-0">
                    <input asp-for="Diagnosis" class="form-control mb-2 shadow-none" placeholder="Примарна дијагноза (МКБ-10 код или опис)..." required />
                    <textarea asp-for="Notes" class="form-control shadow-none" rows="3" placeholder="Забелешки од лекарот / наоди од физички преглед..."></textarea>
                </div>
            </div>

           
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-capsule text-primary me-2"></i>Препишана Терапија / Рецепти
                    </h5>
                   
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#issuePrescriptionModal">
                        <i class="bi bi-plus-circle me-1"></i> Издај Рецепт
                    </button>
                </div>
                <div class="card-body pt-0">
                   
                   
                    <input type="hidden" id="prescriptionsJson" name="PrescriptionsJson" />

                  
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Име на лек</th>
                                    <th>Доза</th>
                                    <th>Упатство / Честота</th>
                                    <th>Времетраење</th>
                                    <th class="text-end">Акција</th>
                                </tr>
                            </thead>
                            <tbody id="prescriptionsTableBody">
                                <tr id="noPrescriptionsRow">
                                    <td colspan="5" class="text-center text-muted py-3 small">
                                        Нема издадено рецепти за овој преглед.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">

            <div class="card shadow-sm border-0 mb-4 border-start border-primary border-4">
                <div class="card-header bg-white py-3 border-0">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-person-vcard text-primary me-2"></i>Податоци за пациент
                    </h6>
                </div>
                <div class="card-body pt-0">
                    <h5 class="fw-bold text-dark mb-3">@Model.PatientFullName</h5>

                    <div class="mb-2">
                        <span class="text-muted small d-block">Телефон:</span>
                        <span class="fw-semibold text-dark"><i class="bi bi-telephone me-1"></i>@Model.PatientPhone</span>
                    </div>

                    <div class="mb-2">
                        <span class="text-muted small d-block">Емаил адреса:</span>
                        <span class="fw-semibold text-dark"><i class="bi bi-envelope me-1"></i>@Model.PatientEmail</span>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-0">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-clock-history text-secondary me-2"></i>Претходни прегледи
                    </h6>
                </div>
                <div class="card-body pt-0" style="max-height: 400px; overflow-y: auto;">
                    @if (Model.PastAppointments != null && Model.PastAppointments.Any())
                    {
                        foreach (var past in Model.PastAppointments)
                        {
                            <div class="border-bottom pb-3 mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <small class="fw-bold text-primary">@past.AppointmentDate.ToString("dd.MM.yyyy")</small>
                                    <small class="text-muted">@past.AppointmentDate.ToString("HH:mm")</small>
                                </div>
                                <div class="fw-semibold small text-dark mb-1">Дијагноза: @(past.Diagnosis ?? "Нема наведено")</div>
                                <div class="text-muted extra-small" style="white-space: pre-line;">Терапија: @(past.Prescriptions ?? "Нема")</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-3 small">
                            Нема претходни завршени прегледи за овој пациент.
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</form>


<div class="modal fade" id="issuePrescriptionModal" tabindex="-1" aria-labelledby="issuePrescriptionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="issuePrescriptionModalLabel">
                    <i class="bi bi-capsule me-2"></i>Издавање Рецепт
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="prescriptionModalForm">
                    <div class="mb-3">
                        <label for="modalMedicationName" class="form-label fw-semibold">Име на лек</label>
                        <input type="text" class="form-control" id="modalMedicationName" placeholder="пр. Парацетамол, Амоксицилин..." />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label for="modalDosage" class="form-label fw-semibold">Доза</label>
                            <input type="text" class="form-control" id="modalDosage" placeholder="пр. 500mg, 10ml" />
                        </div>
                        <div class="col-md-6">
                            <label for="modalDuration" class="form-label fw-semibold">Времетраење</label>
                            <input type="text" class="form-control" id="modalDuration" placeholder="пр. 7 дена, 2 недели" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="modalFrequency" class="form-label fw-semibold">Упатство за користење / Дозирање</label>
                        <textarea class="form-control" id="modalFrequency" rows="2" placeholder="пр. 3 пати на ден по 1 таблета после јадење"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Откажи</button>
                <button type="button" class="btn btn-success btn-sm px-3" id="savePrescriptionBtn">
                    <i class="bi bi-check-lg me-1"></i> Додај рецепт
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const prescriptions = [];
            const prescriptionsTableBody = document.getElementById("prescriptionsTableBody");
            const savePrescriptionBtn = document.getElementById("savePrescriptionBtn");
            const modalEl = document.getElementById("issuePrescriptionModal");
            const bsModal = new bootstrap.Modal(modalEl);

            savePrescriptionBtn.addEventListener("click", function () {
                const medication = document.getElementById("modalMedicationName").value.trim();
                const dosage = document.getElementById("modalDosage").value.trim();
                const duration = document.getElementById("modalDuration").value.trim();
                const frequency = document.getElementById("modalFrequency").value.trim();

             

                
                let fullInstructions = "";
                if (dosage) fullInstructions += `Доза: ${dosage}. `;
                if (frequency) fullInstructions += `Упатство: ${frequency}. `;
                if (duration) fullInstructions += `Времетраење: ${duration}.`;

                const item = {
                    medication: medication,
                    instructions: fullInstructions.trim(),
                    dosage: dosage,
                    duration: duration,
                    frequency: frequency
                };

                prescriptions.push(item);
                updatePrescriptionsUI();

                document.getElementById("prescriptionModalForm").reset();
                bsModal.hide();
            });

            function updatePrescriptionsUI() {
                
                document.getElementById("prescriptionsJson").value = JSON.stringify(prescriptions);

                if (prescriptions.length === 0) {
                    prescriptionsTableBody.innerHTML = `
            <tr id="noPrescriptionsRow">
                <td colspan="5" class="text-center text-muted py-3 small">
                    Нема издадено рецепти за овој преглед.
                </td>
            </tr>`;
                    return;
                }

                let html = "";
                prescriptions.forEach((p, index) => {
                    html += `
            <tr>
                <td class="fw-bold text-dark">${escapeHtml(p.medication)}</td>
                <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle">${escapeHtml(p.dosage || "—")}</span></td>
                <td class="small text-muted">${escapeHtml(p.frequency || "—")}</td>
                <td class="small text-muted">${escapeHtml(p.duration || "—")}</td>
                <td class="text-end">
                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 remove-prescription-btn" data-index="${index}">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>`;
                });

                prescriptionsTableBody.innerHTML = html;

                document.querySelectorAll(".remove-prescription-btn").forEach(btn => {
                    btn.addEventListener("click", function () {
                        const idx = parseInt(this.dataset.index);
                        prescriptions.splice(idx, 1);
                        updatePrescriptionsUI();
                    });
                });
            }

            function escapeHtml(text) {
                if (!text) return "";
                return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
            }
        });
    </script>
}