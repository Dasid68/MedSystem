    <script>
        document.addEventListener("DOMContentLoaded", function () {
            
            const detailModalEl = document.getElementById('appointmentDetailModal');
            let bsDetailModal = null;
            let currentAppointmentId = null;

            if (detailModalEl) {
                bsDetailModal = new bootstrap.Modal(detailModalEl);

                detailModalEl.addEventListener('hide.bs.modal', function () {
                    if (document.activeElement && detailModalEl.contains(document.activeElement)) {
                        document.activeElement.blur();
                    }
                });
            }

            document.querySelectorAll('.view-details-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    currentAppointmentId = this.dataset.id;
                    
                    document.getElementById('modalPatientName').textContent = this.dataset.patient;
                    document.getElementById('modalPatientPhone').textContent = this.dataset.phone;
                    document.getElementById('modalAppointmentDate').textContent = this.dataset.date;
                    document.getElementById('modalAppointmentReason').textContent = this.dataset.reason;

                    if (bsDetailModal) {
                        bsDetailModal.show();
                    }
                });
            });

            async function approveAppointment(id, btnElement) {
                if (btnElement) btnElement.disabled = true;

                try {
                    const res = await fetch(`/api/doctor/approve-appointment?id=${id}`, { method: 'POST' });
                    if (res.ok) {
                        window.location.reload();
                    } else {
                        if (btnElement) btnElement.disabled = false;
                    }
                } catch (err) {
                    console.error(err);
                    if (btnElement) btnElement.disabled = false;
                }
            }

            async function rejectAppointment(id, btnElement) {
             
                
                if (btnElement) btnElement.disabled = true;

                try {
                    const res = await fetch(`/api/doctor/reject-appointment?id=${id}`, { method: 'POST' });
                    if (res.ok) {
                        window.location.reload();
                    } else {
                        if (btnElement) btnElement.disabled = false;
                    }
                } catch (err) {
                    console.error(err);
                    if (btnElement) btnElement.disabled = false;
                }
            }

            document.querySelectorAll('.approve-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    approveAppointment(this.dataset.id, this);
                });
            });

            document.querySelectorAll('.reject-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    rejectAppointment(this.dataset.id, this);
                });
            });

            document.getElementById('modalApproveBtn').addEventListener('click', function () {
                if (currentAppointmentId) {
                    approveAppointment(currentAppointmentId, this);
                }
            });

            document.getElementById('modalRejectBtn').addEventListener('click', function () {
                if (currentAppointmentId) {
                    rejectAppointment(currentAppointmentId, this);
                }
            });
        });
    </script>
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const cancelModalEl = document.getElementById('cancelConfirmModal');
            let bsCancelModal = cancelModalEl ? new bootstrap.Modal(cancelModalEl) : null;
            let appointmentToCancelId = null;

            document.querySelectorAll('.cancel-upcoming-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    appointmentToCancelId = this.dataset.id;
                    document.getElementById('cancelModalPatientName').textContent = this.dataset.patient;
                    if (bsCancelModal) bsCancelModal.show();
                });
            });

            document.getElementById('confirmCancelBtn')?.addEventListener('click', async function () {
                if (!appointmentToCancelId) return;
                this.disabled = true;

                try {
                    const res = await fetch(`/api/booking/reject-appointment?id=${appointmentToCancelId}`, { method: 'POST' });
                    if (res.ok) {
                        if (bsCancelModal) bsCancelModal.hide();

                        const row = document.getElementById(`upcoming-row-${appointmentToCancelId}`);
                        if (row) {
                            row.style.transition = "all 0.4s ease";
                            row.style.opacity = "0";
                            row.style.transform = "translateX(20px)";
                            setTimeout(() => row.remove(), 400);
                        }

                        showNotification('Терминот е успешно откажан.');
                    } else {
                        showNotification('Настана грешка при откажувањето.', false);
                    }
                } catch (err) {
                    console.error(err);
                    showNotification('Мрежна грешка. Обидете се повторно.', false);
                } finally {
                    this.disabled = false;
                }
            });
        });
        
    </script>
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const specialtySelect = document.getElementById("specialtySelect");
            const doctorSelectContainer = document.getElementById("doctorSelectContainer");
            const doctorSelect = document.getElementById("doctorSelect");

            specialtySelect.addEventListener("change", function () {
                const selectedSpecialty = this.value;

                if (!selectedSpecialty) {
                    doctorSelectContainer.style.display = "none";
                    doctorSelect.innerHTML = '<option value="" selected disabled>-- Избери доктор --</option>';
                    return;
                }

                fetch(`/Doctor/getdoctorsbyspecialty?specialty=${encodeURIComponent(selectedSpecialty)}`)
                    .then(response => response.json())
                    .then(data => {
                        doctorSelect.innerHTML = '<option value="" selected disabled>-- Избери доктор --</option>';

                        if (data.length > 0) {
                            data.forEach(doctor => {
                                const option = document.createElement("option");
                                option.value = doctor.id;
                                option.textContent = doctor.name;
                                doctorSelect.appendChild(option);
                            });
                            doctorSelectContainer.style.display = "block";
                        } else {
                            const option = document.createElement("option");
                            option.value = "";
                            option.textContent = "Нема достапни доктори во овој оддел";
                            option.disabled = true;
                            doctorSelect.appendChild(option);
                            doctorSelectContainer.style.display = "block";
                        }
                    })
                    .catch(error => console.error("Грешка при преземање доктори:", error));
            });
        });
    </script>
}