@using MedSystem.Enums
@model MedSystem.Models.ApplicationUser
@{
    ViewData["Title"] = "Почетна страница";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold text-dark mb-1">@if (DateTime.Now.Hour < 19)
                                               {
                                                   <span>Добар ден</span>
                                               }
                                               else
                                               {
                                                   <span>Добро вечер</span>}, @Model.FirstName @Model.LastName</h2>
            <p class="text-muted">Прегледајте ги вашите медицински информации, претстојни прегледи и активни документи.</p>
        </div>
    </div>

    @* <div class="row mb-4"> *@
    @*     <div class="col-12"> *@
    @*         <div class="card border-start border-4 border-primary shadow-sm bg-gradient-light"> *@
    @*             <div class="card-body p-4 d-flex align-items-center justify-content-between flex-wrap g-3"> *@
    @*                 <div class="d-flex align-items-center"> *@
    @*                     <div class="bg-primary text-white p-3 rounded-3 me-3"> *@
    @*                         <i class="bi bi-calendar-check fs-3"></i> *@
    @*                     </div> *@
    @*                     <div> *@
    @*                         <h5 class="mb-1 fw-bold text-primary">Вашиот следен преглед е наскоро!</h5> *@
    @*                         <p class="mb-0 text-dark"><strong>Д-р Петар Петровски</strong> (Кардиологија) — <span class="text-muted">30.06.2026 во 10:30 часот</span></p> *@
    @*                     </div> *@
    @*                 </div> *@
    @*                 <div> *@
    @*                     <a href="#" class="btn btn-primary btn-sm px-3 rounded-pill">Види детали</a> *@
    @*                     <a href="#" class="btn btn-outline-danger btn-sm px-3 rounded-pill ms-2">Откажи</a> *@
    @*                 </div> *@
    @*             </div> *@
    @*         </div> *@
    @*     </div> *@
    @* </div> *@

    @if (ViewBag.UpcomingAppointment != null)
    {
        var appointment = (Appointment)ViewBag.UpcomingAppointment;
    
        <div class="alert alert-warning alert-dismissible fade show shadow-sm border-start border-warning border-4 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-calendar-event fs-3 me-3 text-warning"></i>
                <div>
                    <h6 class="alert-heading fw-bold mb-1">Закажан преглед наскоро!</h6>
                    <p class="mb-0 small">
                        Имате закажано преглед кај <strong>д-р @appointment.Doctor.ApplicationUser.FirstName @appointment.Doctor.ApplicationUser.LastName</strong> 
                        на <strong>@appointment.AppointmentDate.ToString("dd.MM.yyyy")</strong> во <strong>@appointment.AppointmentDate.ToString("HH:mm")</strong> часот.
                    </p>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4 ">
            <div class="card border-0 shadow-sm h-100 rounded-3">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="bg-info-subtle text-info p-3 rounded-3 me-3">
                        <i class="bi bi-clock-history fs-4"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-0 small">Закажани термини</h6>
                        <h3 class="fw-bold mb-0">@Model.Patient?.Appointments.Count</h3>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-12 col-md-4 ">
            <div class="card border-0 shadow-sm h-100 rounded-3">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="bg-warning-subtle text-warning p-3 rounded-3 me-3">
                        <i class="bi bi-file-earmark-medical fs-4"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-0 small">Активни упати</h6>
                        <h3 class="fw-bold mb-0">@Model.Patient?.Referrals.Count</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4 ">
            <div class="card border-0 shadow-sm h-100 rounded-3">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="bg-success-subtle text-success p-3 rounded-3 me-3">
                        <i class="bi bi-capsule fs-4"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-0 small">Рецепти за подигање</h6>
                        <h3 class="fw-bold mb-0">@Model.Patient?.Prescriptions.Count</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row g-4 mb-4">
        
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-dark">Мои термини</h5>
                    <a href="#" class="small text-primary text-decoration-none">Види ги сите</a>
                </div>
                <div class="card-body pt-0">
                    @{
                        var appointments = Model.Patient?.Appointments?
                            .OrderBy(a => a.AppointmentDate)
                            .Take(4)
                            .ToList() ?? new List<Appointment>();
                    }

                    @if (!appointments.Any())
                    {
                        <p class="text-muted small mb-0 py-2">Немате закажани прегледи.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var appointment in appointments)
                            {
                                var (badgeClass, statusText) = appointment.Status switch
                                {
                                    Status.Pending => ("bg-warning-subtle text-warning", "Чекање потврда"),
                                    Status.Confirmed => ("bg-success-subtle text-success", "Потврден"),
                                    Status.Cancelled => ("bg-danger-subtle text-danger", "Откажан"),
                                    Status.Completed => ("bg-secondary-subtle text-secondary", "Завршен"),
                                    _ => ("bg-secondary-subtle text-secondary", "Непознато")
                                };

                                <div class="d-flex align-items-center justify-content-between p-2 rounded-3 border">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bg-primary-subtle text-primary rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                            <i class="bi bi-calendar-event"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold small">Д-р @appointment.Doctor?.ApplicationUser?.FirstName @appointment.Doctor?.ApplicationUser?.LastName</div>
                                            <div class="text-muted" style="font-size: 0.78rem;">
                                                @appointment.AppointmentDate.ToString("dd.MM.yyyy") во @appointment.AppointmentDate.ToString("HH:mm")
                                            </div>
                                        </div>
                                    </div>
                                    <span class="badge rounded-pill @badgeClass px-2 py-1" style="font-size: 0.72rem;">
                                        @statusText
                                    </span>
                                    
                                    @if (appointment.Status == Status.Pending || appointment.Status == Status.Confirmed)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-link text-danger p-0  open-delete-modal"
                                                data-appointment-id="@appointment.Id"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal"
                                                id="cancelAppointmentModal">
                                                
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="mb-0 fw-bold text-dark">Брзи акции</h5>
                </div>
                <div class="card-body pt-0">
                    <div class="d-grid gap-2">
                        <a href="#" data-bs-toggle="modal" data-bs-target="#bookAppointmentModal" data-userId="@Model.Id" class="btn btn-outline-primary text-start p-3 rounded-3">
                            <i class="bi bi-calendar-plus me-2 fs-5 align-middle"></i> Закажи нов преглед
                        </a>
                        @* <a href="#" class="btn btn-outline-secondary text-start p-3 rounded-3"> *@
                        @*     <i class="bi bi-folder2-open me-2 fs-5 align-middle"></i> Прегледај медицинско досие *@
                        @* </a> *@
                        @* <a href="#" class="btn btn-outline-secondary text-start p-3 rounded-3"> *@
                        @*     <i class="bi bi-file-earmark-arrow-down me-2 fs-5 align-middle"></i> Преземи лабораториски резултати *@
                        @* </a> *@
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-4 text-center">
                    <div class="mb-3 position-relative d-inline-block">
                        <div class="bg-primary-subtle text-primary rounded-circle p-4 mx-auto d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                            <i class="bi bi-person-heart fs-1"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold mb-1">д-р @Model.Patient!.PrimaryDoctor?.ApplicationUser?.FirstName @Model.Patient!.PrimaryDoctor?.ApplicationUser?.LastName</h5>
                    <p class="text-primary small mb-3">Ваш Матичен Лекар</p>

                    <hr class="text-muted opacity-25">

                    <div class="text-start mb-3">
                        <div class="d-flex align-items-center mb-2 small text-muted">
                            <i class="bi bi-telephone me-2 text-secondary"></i> @Model.Patient!.PrimaryDoctor?.ApplicationUser?.PhoneNumber
                        </div>
                        <div class="d-flex align-items-center small text-muted">
                            <i class="bi bi-envelope me-2 text-secondary"></i> @Model.Patient!.PrimaryDoctor?.ApplicationUser?.Email
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <partial name="Partials/_PrescriptionsTable" model="Model.Patient?.Prescriptions"/>
            <partial name="Partials/_ReferralsTable" model="Model.Patient?.Referrals"/>
        </div>
    </div>
    
        
</div>


<partial name="Partials/_BookAppointment" model="@Model"/>
<partial name="Partials/CancelAppointmentModal"/>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    
    <script>
        (function () {
            let appointmentIdToCancel = null;
           
            document.querySelectorAll('.open-delete-modal').forEach(btn => {
                btn.addEventListener('click', async function () {
                    appointmentIdToCancel = this.dataset.appointmentId;
                    
                    console.log(appointmentIdToCancel)
                    try {
                        const res = await fetch(`/api/booking/get-appointment?appointmentId=${appointmentIdToCancel}`)
                        
                        if(res.ok){
                            const data = await res.json();
                            
                            const date = new Date(data.date).toLocaleDateString('mk-MK', 
                                {
                                    day:'numeric', 
                                    month:'long',
                                    year:'numeric'
                                } 
                            );
                            
                            
                            
                            document.getElementById("cancelDoctorName").innerHTML = data.doctorName;
                            document.getElementById('cancelDateTime').innerHTML = date
                        }
                        
                    } catch (error) {}
                    const row = this.closest('.appointment-row');
                    const doctorName = row.querySelector('.fw-semibold').textContent;
                    const dateTime = row.querySelector('.text-muted').textContent;

                    document.getElementById('cancelDoctorName').textContent = doctorName;
                    document.getElementById('cancelDateTime').textContent = dateTime;

                  
                });
            });

            document.getElementById('confirmCancelBtn').addEventListener('click', function () {
                if (!appointmentIdToCancel) return;

                this.disabled = true;
                this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Откажување...';

                fetch(`/api/booking/cancel?id=${appointmentIdToCancel}`).then(res => {
                    if (res.ok) {
                        window.location.reload();
                    } else {
                        alert('Настана грешка при откажување, обидете се повторно.');
                        this.disabled = false;
                        this.innerHTML = '<i class="bi bi-x-circle me-1"></i> Откажи термин';
                       
                    }
                });
            });
        })();
        
    </script>
    
}