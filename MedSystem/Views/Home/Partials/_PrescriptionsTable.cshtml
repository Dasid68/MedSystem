@model ICollection<Prescription>

<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-capsule me-2 text-success"></i> Мои Активни Рецепти</h5>
        <a href="#" class="btn btn-link btn-sm text-decoration-none p-0">Види ги сите</a>
    </div>


<div class="card-body p-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th class="ps-3 text-secondary small">Лек</th>
                <th class="text-secondary small">Дозирање</th>
                <th class="text-secondary small">Издаден од</th>
                <th class="text-secondary small">Важи до</th>
                <th class="text-secondary small pe-3">Статус</th>
            </tr>
            </thead>
            <tbody>
            
            @if (Model.Any())
            {
                @foreach (var prescription in Model)
                {
                    <tr>
                        <td class="ps-3 fw-bold">@prescription.Medication</td>
                        <td>@prescription.Instructions</td>
                        <td>@prescription.Doctor.ApplicationUser.FirstName + " " + @prescription.Doctor.ApplicationUser.LastName[0] + "."</td>
                        <td>@prescription.ExpirationDate</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill">Активен</span></td>
                        @* <td><span class="badge bg-warning-subtle text-warning rounded-pill">Неподигнат</span></td> *@

                    </tr>
                }
            }
            
            </tbody>
        </table>
    </div>
</div>
</div>