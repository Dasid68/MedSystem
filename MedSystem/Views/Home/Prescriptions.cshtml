
@using System.Globalization
@model IEnumerable<Prescription>

@{
    ViewData["Title"] = "Мои Прегледи";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Мои рецепти</h2>
            <p class="text-muted small mb-0">Преглед на сите ваши рецепти</p>
        </div>
        
      
    </div>

    @if (Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="py-3">Лек</th>
                            <th class="py-3">Упатсво</th>
                            <th scope="col" class="py-3">Издаден од</th>
                            <th scope="col" class="py-3">Важи до</th>
                            <th scope="col" class="py-3">Статус</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prescription in Model)
                        {
                            var daysPassed = (DateTime.Now - prescription.IssuedDate).TotalDays;
                            var isExpired = daysPassed > 7;
                            
                          
                            
    
                            <tr >
                                <td>
                                    @prescription.Medication
                                </td>
                                <td>
                                    @prescription.Instructions
                                </td>
                               
                                <td >@prescription.Doctor.ApplicationUser.FirstName @prescription.Doctor.ApplicationUser.LastName
                                </td>
    
                                <td>
                                    @prescription.ExpirationDate.ToString("d",new CultureInfo("mk-MK"))
                                </td>
                                
                                @if (isExpired)
                                {
                                    <td><span class="badge bg-danger-subtle text-danger rounded-pill">Истечен</span></td>
                                }
                                else
                                {
                                    <td><span class="badge bg-success-subtle text-success rounded-pill">Активен</span></td>
                                }
    
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 text-center p-5 rounded-3">
            <div class="my-3">
                <i class="bi bi-calendar-x fs-1 text-muted opacity-50"></i>
                <h5 class="fw-bold mt-3">Немате закажано прегледи</h5>
                <p class="text-muted small">Сите ваши идни и поминати прегледи ќе се појават тука.</p>
                <a href="#" data-bs-toggle="modal" data-bs-target="#bookAppointmentModal" data-userId="@ViewBag.UserId" class="btn btn-primary shadow-sm">
                    Закажи го твојот прв преглед
                </a>
            </div>
        </div>
    }
</div>

