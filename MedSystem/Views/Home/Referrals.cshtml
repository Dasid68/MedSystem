@using MedSystem.Enums
@model List<Referral>

@{
    ViewData["Title"] = "Мои Упати";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Мои упати</h2>
            <p class="text-muted small mb-0">Преглед на сите ваши издадени упати за прегледи</p>
        </div>
        
       
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="py-3 px-4">Оддел</th>
                            <th scope="col" class="py-3">Издаден од</th>
                            <th scope="col" class="py-3">Упатен кај</th>
                            <th scope="col" class="py-3">Датум на преглед</th>
                            <th scope="col" class="py-3">Статус</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reff in Model)
                        {
                            var isExpired = (DateTime.Now - reff.IssuingDate).TotalDays > 30;

                            <tr>
                                <td class="px-4">
                                    <div class="fw-bold text-dark">
                                        @(reff.ReferringSpecialization?.Name )
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-primary">
                                        Д-р @reff.ReferringDoctor?.ApplicationUser?.FirstName @reff.ReferringDoctor?.ApplicationUser?.LastName
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-primary">
                                        Д-р @reff.ReferredDoctor?.ApplicationUser?.FirstName @reff.ReferredDoctor?.ApplicationUser?.LastName
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold">@reff.IssuingDate.ToString("dd.MM.yyyy")</div>
                                </td>
                                <td>
                                    @if (isExpired)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-2">
                                            Изминат
                                        </span>
                                    }
                                    else
                                    {
                                        
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                                            Активен
                                        </span>
                                       
                                    }
                                </td>
                              
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 text-center p-5 rounded-3">
            <div class="my-3">
                <i class="bi bi-file-earmark-x fs-1 text-muted opacity-50"></i>
                <h5 class="fw-bold mt-3">Немате издадени упати</h5>
                <p class="text-muted small">Сите ваши издадени упати од лекарите ќе се појават тука.</p>
                
            </div>
        </div>
    }
</div>

<partial name="Partials/CancelAppointmentModal" />

@if (ViewBag.User != null)
{
    <partial name="Partials/_BookAppointment" model="@ViewBag.User" />
}

