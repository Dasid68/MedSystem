@model List<Notification>
@{
    var unreadCount = Model.Count(n => !n.IsRead);
}

<div class="dropdown">
    <a href="#" class="position-relative text-white" data-bs-toggle="dropdown">
        <i class="bi bi-bell fs-5"></i>
        @if (unreadCount > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">
                @unreadCount
            </span>
        }
    </a>
    
        @if (Model.Any())
        {
            <ul class="dropdown-menu dropdown-menu-end">
        
                @foreach (var n in Model)
                {
                    <li>
                        <a class="dropdown-item @(n.IsRead ? "" : "fw-bold")" href="@(n.Link ?? "#")">
                            @n.Message
                            <div class="small text-muted">@n.CreatedAt.ToString("dd.MM HH:mm")</div>
                        </a>
                    </li>
                }
            </ul>
        }
  
</div>